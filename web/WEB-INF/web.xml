<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>He Thong Tra Cuu va Quan Ly Thu Vien</display-name>

    <!-- 1. Catalog & Book Search Controller -->
    <servlet>
        <servlet-name>CatalogServlet</servlet-name>
        <servlet-class>controllers.CatalogServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>CatalogServlet</servlet-name>
        <url-pattern>/catalog</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>CatalogServlet</servlet-name>
        <url-pattern>/book</url-pattern>
    </servlet-mapping>

    <!-- 2. Borrow Cart Controller -->
    <servlet>
        <servlet-name>BorrowCartServlet</servlet-name>
        <servlet-class>controllers.BorrowCartServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BorrowCartServlet</servlet-name>
        <url-pattern>/cart</url-pattern>
    </servlet-mapping>

    <!-- 3. Borrow & History Controller -->
    <servlet>
        <servlet-name>BorrowServlet</servlet-name>
        <servlet-class>controllers.BorrowServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>BorrowServlet</servlet-name>
        <url-pattern>/borrow</url-pattern>
    </servlet-mapping>

    <!-- 4. User Authentication & Profile Controller -->
    <servlet>
        <servlet-name>UserServlet</servlet-name>
        <servlet-class>controllers.UserServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserServlet</servlet-name>
        <url-pattern>/user</url-pattern>
    </servlet-mapping>

    <!-- 5. Admin & Librarian Management Controller -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>controllers.AdminServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
    </servlet-mapping>

    <!-- Welcome File -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Error Page: Tu dong chuyen huong ve index.jsp (roi redirect catalog) neu duong dan khong hop le -->
    <error-page>
        <error-code>404</error-code>
        <location>/index.jsp</location>
    </error-page>

</web-app>
